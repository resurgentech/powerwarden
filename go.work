go 1.25.0

use (
	./powermaster/api
	./powermaster/daemon
	./powerwarden/api
	./powerwarden/daemon
	./powerwarden/mcp
)

// Intra-repo requires name a tag (v0.1.0). These versioned replaces point that
// exact version at the workspace copy, so in-repo work needs no published tag.
// When an intra-repo require moves to a new version, move its replace with it.
replace github.com/resurgentech/powerwarden/powermaster/api v0.1.0 => ./powermaster/api

replace github.com/resurgentech/powerwarden/powerwarden/api v0.1.0 => ./powerwarden/api
