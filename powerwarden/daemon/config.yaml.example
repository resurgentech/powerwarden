# config.yaml.example — powerwarden
# Every key with its default. Unknown keys are a startup error.
listen: ":8091"
state_path: /var/lib/powerwarden/state.db
tokens_file: /etc/powerwarden/tokens.yaml      # name -> token; mode 0600
log_level: info                                 # debug | info | warn | error

powermaster:
  url: https://powermaster.lab.example     # REQUIRED (no default)
  token_file: /etc/powerwarden/powermaster.token
  request_timeout: 10s

timings:
  reconcile_interval: 15s
  power_on_spacing: 15s
  host_view_refresh: 60s
  boot_grace: 5m
  boot_cooldown: 10m
  min_idle_time: 10m
  busy_grace: 7200s
  demand_lease_default: 3600s
  demand_lease_min: 30s
  demand_lease_max: 3600s
  worker_lease_default: 90s
  worker_lease_min: 15s
  worker_lease_max: 300s
  demand_sweep_after: 24h
  worker_sweep_extra: 24h
  cold_off_after: 1h           # soft_off dwell before a powercut; 0 disables powercut
  # Claims. The lease is the liveness window a re-PUT renews; the cap
  # (expires_at) moves only by extend. Requests outside min..max are clamped.
  claim_lease_default: 15m
  claim_lease_min: 60s
  claim_lease_max: 1h
  claim_cap_default: 8h
  claim_cap_min: 15m
  claim_cap_max: 72h
  claim_restart_grace: 5m      # lease grace after a powerwarden restart (PWC8)
  claim_wait_max: 60s          # longest blocking read on GET /v1/claims (PWC8b)
  claim_sweep_after: 24h       # lapsed claims are deleted this long after lapsing

limits:
  max_demands: 500
  max_claims: 64               # live claims incl. detached; more is 429 capacity
  max_tags: 32
  decisions_kept: 500

events:
  ring_size: 1000
  heartbeat: 15s

ui:
  enabled: true
  # How the UI knows who you are: "htpasswd" (default; basic auth against
  # htpasswd_file) or "proxy" (a reverse proxy authenticates users and sends the
  # name and a shared secret in headers; htpasswd_file is then not read).
  # auth: htpasswd
  htpasswd_file: /etc/powerwarden/ui.htpasswd
  # Only for auth: proxy. All three keys are required then, and none has a
  # default (header names depend on your proxy). Setting them with auth: htpasswd
  # is an error.
  # proxy:
  #   # One secret per line (at least 16 characters; blank lines and # comments
  #   # skipped; two lines allow rotation). Startup fails if the file has any
  #   # group or other permission bit: chmod 600.
  #   secret_file: /etc/powerwarden/ui-proxy.secret
  #   # Header the proxy sets to the shared secret.
  #   secret_header: X-Example-Proxy-Secret
  #   # Header the proxy sets to the authenticated user name
  #   # (letters, digits, _ . @ -, at most 64; the UI caller is "ui:<name>").
  #   user_header: X-Example-User
  # Serve the UI under <path_prefix>/ui for a reverse proxy that does not strip
  # the prefix, e.g. "/powerwarden". Empty serves at /ui. Must start with "/",
  # not end with "/", and use only letters, digits, . _ ~ - in each segment.
  path_prefix: ""

# Optional. Advertise where a person requests a key for this service, at the
# unauthenticated GET /v1/key-request. Must be an absolute http or https URL
# with a host, no user information and no fragment. Unset: that route is 404.
# personal_keys:
#   request_url: https://keys.example.com/v1/services/powerwarden/requests
#   # The key list that people's personal keys are pulled from (keyclient's
#   # docs/CONTRACT.md). "" (the default) turns it off. Every key below is an
#   # error while url is empty; cache_file is required once url is set.
#   url: https://keys.example.com/v1/lists/powerwarden
#   token_file: /etc/powerwarden/keylist.token   # default "": the pull token, optional
#   cache_file: /var/lib/powerwarden/keys.cache  # no default: where the last good list is kept
#   refresh: 1m                                  # default 1m: time between pulls, greater than zero
#   refresh_on_miss: 5s                          # default 5s: least time between pulls an unknown key starts; 0s turns it off
#   allow_insecure_http: false                   # default false: allow a plain-http url to a host that is not loopback

# Optional seed for host capability tags (what a host can run when powered
# on). Tags live in powerwarden's database and are edited with
# PUT /v1/hosts/{hostname}/tags or the web UI. A host here is seeded only
# when it has no stored tags; the stored value wins after that. A host with
# no stored tags has no capability: powerwarden never powers it on for a
# demand.
# Default: none.
# host_tags:
#   node01.lab.example: [kernel]
#   node02.lab.example: [kernel]
