# Image settings for `just image` / `just push` in powermaster/daemon and
# powerwarden/daemon, and for `just logs` there. Copy to images.env (gitignored)
# or export these. Empty values are fine for building: images get a local-only
# tag and trust system CAs only.

# Registry prefix, e.g. registry.example.com. Empty: tag is <name>:<tag>, `push` fails.
IMAGE_REGISTRY=

# Absolute path to an extra CA certificate (PEM) to trust inside the images. Empty: system CAs only.
IMAGE_CA_CERT=

# Host for `just logs` (or pass it as an argument). No default.
LOGS_HOST=

# Directory on LOGS_HOST that holds the compose projects; `just logs` runs
# `docker compose logs -f` in $LOGS_DIR/<service>. No default: `just logs` fails when unset.
LOGS_DIR=
